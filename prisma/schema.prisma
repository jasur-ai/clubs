// TDIU Clubs — data model
// Multi-club from day one: every content entity is scoped to a Club (or platform-wide).
// SQLite is used for local development; switch `provider` to "postgresql" for production
// (see docs/DEPLOYMENT.md). Field types are chosen so the swap is low-risk.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  telegramId   String?  @unique
  username     String?
  firstName    String
  lastName     String?
  email        String?  @unique
  passwordHash String?
  photoUrl     String?
  role         String   @default("MEMBER") // SUPER_ADMIN | CLUB_ADMIN | EDITOR | MEMBER
  points       Int      @default(0)
  locale       String   @default("uz")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  joinRequests  JoinRequest[]      @relation("JoinRequestUser")
  progress      ReadingProgress[]
  threads       DiscussionThread[]
  posts         Post[]
  rsvps         EventRsvp[]
  news          News[]
  notifications Notification[]
  auditLogs     AuditLog[]
  EventFeedback EventFeedback[]

  @@index([role])
}

model Club {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  shortName    String?
  tagline      String
  summary      String
  description  String
  category     String // intellectual | academic | creative | sport | social | travel
  accent       String   @default("#0f6b39")
  logoUrl      String? // club's own emblem, seeded from /public/clubs/<slug>.jpg
  coverStyle   String   @default("grid") // visual variant for generated covers
  telegramUrl  String?
  instagramUrl String?
  email        String?
  meetingDay   String?
  meetingTime  String?
  location     String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  joinRequests JoinRequest[]
  books        Book[]
  cycles       ReadingCycle[]
  threads      DiscussionThread[]
  events       Event[]
  news         News[]
  resources    Resource[]

  @@index([category])
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  role     String   @default("MEMBER") // PRESIDENT | MANAGER | MEMBER
  status   String   @default("ACTIVE") // ACTIVE | PENDING | BLOCKED
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId, status])
}

model JoinRequest {
  id         String   @id @default(cuid())
  clubId     String
  userId     String?
  fullName   String
  faculty    String
  course     String
  group      String?
  phone      String
  telegram   String
  motivation String?
  status     String   @default("NEW") // NEW | IN_REVIEW | APPROVED | REJECTED
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  club Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User? @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId, status])
}

// ---------------------------------------------------------------------------
// Reading programme (Book Club core)
// ---------------------------------------------------------------------------

model Book {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  author      String
  year        Int?
  pages       Int?
  language    String   @default("uz")
  description String
  genre       String?
  coverFrom   String    @default("#1b4b31")
  coverTo     String    @default("#3f7a55")
  sourceUrl   String?
  createdAt   DateTime @default(now())

  club   Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  cycles ReadingCycle[]

  @@index([clubId])
}

model ReadingCycle {
  id        String    @id @default(cuid())
  clubId    String
  bookId    String
  status    String    @default("PLANNED") // PLANNED | READING | FINISHED | ARCHIVED
  // The club runs more than one reading programme on the same shelf
  // (Bookonomics, Bir oyda bir kitob), and a member needs to know which.
  program   String?   @default("Bookonomics")
  startsAt  DateTime?
  endsAt    DateTime?
  meetingAt DateTime?
  location  String?
  focus     String? // discussion focus, newline separated
  createdAt DateTime  @default(now())

  club       Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  book       Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  progress   ReadingProgress[]
  threads    DiscussionThread[]

  @@index([clubId, status])
}

model Milestone {
  id      String   @id @default(cuid())
  cycleId String
  title   String
  dueAt   DateTime
  sort    Int      @default(0)

  cycle ReadingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model ReadingProgress {
  id        String   @id @default(cuid())
  cycleId   String
  userId    String
  percent   Int      @default(0)
  pagesRead Int      @default(0)
  note      String?
  updatedAt DateTime @updatedAt

  cycle ReadingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  clubId    String
  cycleId   String?
  authorId  String?
  title     String
  body      String
  kind      String   @default("DISCUSSION") // DISCUSSION | QUESTION | ANNOUNCEMENT
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  cycle  ReadingCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  posts  Post[]

  @@index([clubId, createdAt])
}

model Post {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ---------------------------------------------------------------------------
// Events, news, notifications
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(cuid())
  clubId      String
  title       String
  description String
  type        String    @default("meetup") // meetup | workshop | contest | trip | sport
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  capacity    Int?
  coverFrom   String    @default("#1b4b31")
  coverTo     String    @default("#3f7a55")
  status      String    @default("DRAFT") // DRAFT | PUBLISHED | CANCELLED | FINISHED
  seriesId    String? // groups the weekly occurrences of one recurring meeting
  createdAt   DateTime  @default(now())

  club     Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rsvps    EventRsvp[]
  feedback EventFeedback[]

  @@index([clubId, startsAt])
  @@index([seriesId])
}

model EventRsvp {
  id         String    @id @default(cuid())
  eventId    String
  userId     String
  status     String    @default("GOING") // GOING | MAYBE | WAITLIST | CANCELLED
  createdAt  DateTime  @default(now())
  attendedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model News {
  id          String    @id @default(cuid())
  clubId      String?
  authorId    String?
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  coverFrom   String    @default("#1b4b31")
  coverTo     String    @default("#3f7a55")
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club   Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

// Post-event rating. One per member per event; drives the club's public score.
model EventFeedback {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model SiteSetting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Club resources: reading packs, schedules, bylaws — the files that otherwise
// live in a Telegram chat and are impossible to find three weeks later.
// ---------------------------------------------------------------------------

model Resource {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  url         String
  kind        String   @default("link") // link | file | guide
  createdAt   DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}
