# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public URL of the deployment (used in metadata, bot buttons, OG images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ byte random string: openssl rand -base64 48
AUTH_SECRET="change-me-in-production"

# ---------------------------------------------------------------------------
# Database — SQLite for local dev, PostgreSQL for production
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Telegram (create a bot with @BotFather)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Seed admin (change before any public deployment)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@clubs.tdiu.uz"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# ---------------------------------------------------------------------------
# Per-club bots (optional)
# Each club can run its own BotFather bot. The webhook becomes
# /api/telegram/<slug> and the token is read from TELEGRAM_BOT_TOKEN_<SLUG>.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN_BOOK_CLUB=""
# TELEGRAM_WEBHOOK_SECRET_BOOK_CLUB=""
# TELEGRAM_BOT_TOKEN_DEBATE=""
